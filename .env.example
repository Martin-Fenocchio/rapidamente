# Server-only MongoDB connection and explicit database name. No production fallback.
MONGODB_URI=
MONGODB_DB=

# Better Auth: generate a random signing secret; URL must match the trusted origin.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth is optional until configured; keep the client secret server-only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Empty for the Vercel root. For a subpath deployment use /rapidamente.
NEXT_PUBLIC_BASE_PATH=

# Optional observability; empty keeps local tests independent of external services.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SENTRY_DSN=
# Server/build-only token used to upload Sentry source maps, when configured.
SENTRY_AUTH_TOKEN=
